{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_content %}
    {% block page_fast_order_product_table %}
        <div class="fast-order">
            {% block page_fast_order_table_container %}
                <div class="card">
                    <div class="card-body">
                        {% block page_fast_order_card_description %}
                            <h5 class="card-title">{{ "FastOrder.card.articlesTitle"|trans|sw_sanitize }}</h5>
                            <p class="card-text">
                                {{ "FastOrder.card.text"|trans|sw_sanitize }}
                            </p>
                        {% endblock %}

                        {% block page_fast_order_form %}
                            <form action="{{ path('frontend.fast.order.add-to-cart') }}"
                                method="post"
                                class="js-article-search-form">

                                {% block page_fast_order_table_redirect %}
                                    <input type="hidden"
                                           name="redirectTo"
                                           value="frontend.checkout.cart.page">
                                {% endblock %}

                                {% block page_fast_order_table_header %}
                                    {% sw_include '@FastOrder/storefront/component/fast-order/header.html.twig' %}
                                {% endblock %}

                                {% block page_fast_order_table_items %}
                                    {% for i in 0..10 %}
                                        {% sw_include '@FastOrder/storefront/component/fast-order/item.html.twig' %}
                                    {% endfor %}
                                {% endblock %}

                                {% block page_fast_order_form_total_amount %}
                                    <div class="form-group row">
                                        <div class="col-8">
                                        </div>
                                        <div class="col-4 text-right">
                                            <p class="form-control-plaintext">{{ "FastOrder.form.totalAmount"|trans|sw_sanitize }} <strong class="js-total-amount">€0</strong></p>
                                        </div>
                                    </div>
                                {% endblock %}

                                {% block page_fast_order_form_add_to_cart %}
                                    <button type="submit" class="btn btn-primary">{{ "FastOrder.form.submitButtonTitle"|trans|sw_sanitize }}</button>
                                {% endblock %}
                            </form>
                        {% endblock %}
                    </div>
                </div>
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
