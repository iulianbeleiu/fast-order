{% block component_item_fast_order_product %}
    <div class="form-group row" data-fast-order-search="true" data-article-search-url="{{ path('frontend.fast.order.article.suggest') }}?search=">
        {% block component_item_fast_order_article_col_title %}
            <div class="col-8">
                <input type="search" class="form-control" id="article" placeholder="Search article...">
                <p class="form-control-plaintext js-selected-article-title"></p>
            </div>
        {% endblock %}

        {% block component_item_fast_order_article_col_quantity %}
            <div class="col-4">
                <input type="number" class="form-control js-quantity" id="quantity" min="1" placeholder="Quantity">
                <p class="form-control-plaintext js-selected-article-price" data-item-total="0"></p>
            </div>
        {% endblock %}
    </div>
{% endblock %}
