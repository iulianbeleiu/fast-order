{% block component_item_fast_order_product %}
    <div class="form-group row" data-fast-order-search="true" data-article-search-url="{{ path('frontend.fast.order.article.suggest') }}?search=">
        {% block component_item_fast_order_article_col_title %}
            <div class="col-12 col-md-8 mb-2 mb-md-0">
                <input type="search" class="form-control js-search-field" id="article" name="productNumbers[]" placeholder="Search article...">
                <strong class="form-control-plaintext js-selected-article-title d-none"></strong>
            </div>
        {% endblock %}

        {% block component_item_fast_order_article_col_quantity %}
            <div class="col-12 col-md-4">
                <input type="number" class="form-control js-quantity" id="quantity" name="quantities[]" min="1" placeholder="Quantity">
                <strong class="form-control-plaintext js-selected-article-price d-none" data-item-total="0"></strong>
            </div>
        {% endblock %}
    </div>
{% endblock %}
