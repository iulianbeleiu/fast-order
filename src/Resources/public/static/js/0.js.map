export default "{% block fast_order_line_item_list %}\n    <sw-page class=\"fast-order-item-list-list\">\n        {% block fast_order_line_item_list_smart_bar_header %}\n            <template #smart-bar-header>\n                {% block fast_order_line_item_list_smart_bar_header_title %}\n                <h2>\n                    {% block fast_order_line_itemlist_list_smart_bar_header_title_text %}\n                        {{ $tc('fast-order-item-list.list.orderTextHeadline') }}\n                        <sw-icon name=\"regular-chevron-right-xs\" />\n                        {{ $tc('fast-order-item-list.list.textHeadline') }}\n                    {% endblock %}\n\n                    {% block fast_order_line_item_list_smart_bar_header_amount %}\n                        <span\n                            v-if=\"!isLoading\"\n                            class=\"sw-page__smart-bar-amount\"\n                        >\n                            ({{ total }})\n                        </span>\n                    {% endblock %}\n                </h2>\n                {% endblock %}\n            </template>\n        {% endblock %}\n\n        {% block fast_order_line_itemlist_list_content %}\n            <template #content>\n                {% block fast_order_line_itemlist_list_content_card %}\n                    {% block fast_order_line_itemlist_list_grid %}\n                        <sw-entity-listing\n                            v-if=\"items && entitySearchable\"\n                            :is-loading=\"isLoading\"\n                            :items=\"items\"\n                            :columns=\"columns\"\n                            :repository=\"repository\"\n                            :sort-by=\"currentSortBy\"\n                            :sort-direction=\"sortDirection\"\n                        >\n                        </sw-entity-listing>\n\n                        {% block fast_order_line_item_list_empty_state %}\n                            <template v-if=\"!isLoading && !total\">\n                                <sw-empty-state\n                                    v-if=\"isValidTerm(term)\"\n                                    :title=\"$tc('sw-empty-state.messageNoResultTitle')\"\n                                >\n                                    <template #default>\n                                        {{ $tc('sw-empty-state.messageNoResultSublineBefore') }}\n                                        <router-link\n                                            class=\"sw-empty-state__description-link\"\n                                            :to=\"{ name: 'sw.profile.index.searchPreferences' }\"\n                                        >\n                                            {{ $tc('sw-empty-state.messageNoResultSublineLink') }}\n                                        </router-link>\n                                        {{ $tc('sw-empty-state.messageNoResultSublineAfter') }}\n                                    </template>\n                                </sw-empty-state>\n\n                                <sw-empty-state\n                                    v-else\n                                    :title=\"$tc('fast-order-item-list.list.messageEmpty')\"\n                                />\n                            </template>\n                        {% endblock %}\n                    {% endblock %}\n                {% endblock %}\n            </template>\n        {% endblock %}\n    </sw-page>\n{% endblock %}\n";