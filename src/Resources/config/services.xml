<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="FastOrder\Storefront\Controller\FastOrderController" public="true">
            <argument type="service" id="Shopware\Storefront\Page\Suggest\SuggestPageLoader"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <call method="setTwig">
                <argument type="service" id="twig"/>
            </call>
        </service>

        <service id="FastOrder\Core\Content\Example\SalesChannel\ExampleRoute">
            <argument type="service" id="product.repository"/>
        </service>

        <service id="FastOrder\Core\Content\FastOrderLineItem\FastOrderLineItemDefinition">
            <tag name="shopware.entity.definition" entity="fast_order_line_item" />
        </service>

    </services>
</container>